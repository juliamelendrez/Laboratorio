.include "m328pdef . inc"

.org 0x0000
  rjmp INICIO

INICIO:
  ; Configurar PORTD como salida
  ldi r16, 0xFF
  out DDRD, r16

  ; Inicializar PORTD apagado
  ldi r16, 0x00
  out PORTD, r16

  ; Configurar PB0, PB1 y PB2 como entradas
  ldi r16, 0b11111000
  out DDRB, r16

  ; Activar resistencias pull-up internas
  ldi r16, 0b00000111
  out PORTB, r16

  ; Inicializar contador en 0
  ldi r17, 0
  rcall MOSTRAR_NUMERO

  ; Mostrar 0 en el display
  

MAIN:
  ; Se presionó botón SUBIR en PBO?
  sbic PINB, 0
  rjmp MAIN

  ; Aumentar contador
  inc r17

  ; Si llegó a 10, volver a 0
  cpi r17, 10
  brne MOSTRAR_SUBIDA

  ldi r17, 0

MOSTRAR_SUBIDA:
  ; Mostrar nuevo valor
  rcall MOSTRAR_NUMERO

  ; Esperar a que suelte el botón 
ESPERAR_SUBIR:
  sbis PINB, 0
  rjmp ESPERAR_SUBIR

  rjmp MAIN

REVISAR_BAJAR:
  ; Se presionó botón BAJAR en PB1?
  sbic PINB, 1
  rjmp MAIN

  ; Si está en 0, pasar a 9
  cpi r17, 0
  brne RESTAR

  ldi r17, 9
  rjmp MOSTRAR_BAJADA

RESTAR:
  dec r17

MOSTAR_BAJADA:
  rcall MOSTRAR_NUMERO

ESPERAR_BAJAR:
  sbis PINB, 1
  rjmp ESPERAR_BAJAR

  rjmp MAIN

MOSTRAR_NUMERO:
  cpi r17, 0
  breq MOSTRAR_0

  cpi r17, 1
  breq MOSTRAR_1

    cpi r17, 2
  breq MOSTRAR_2

  cpi r17, 3
  breq MOSTRAR_3

    cpi r17, 4
  breq MOSTRAR_4

  cpi r17, 5
  breq MOSTRAR_5

    cpi r17, 6
  breq MOSTRAR_6

  cpi r17, 7
  breq MOSTRAR_7

    cpi r17, 8
  breq MOSTRAR_8

  cpi r17, 9
  breq MOSTRAR_9

  ret

MOSTRAR_0:
  ldi r16, 0x3F
  out PORTD, r16
  ret

MOSTRAR_1:
  ldi r16, 0x06
  out PORTD, r16
  ret  

MOSTRAR_2:
  ldi r16, 0x5B
  out PORTD, r16
  ret

MOSTRAR_3:
  ldi r16, 0x4F
  out PORTD, r16
  ret  

MOSTRAR_4:
  ldi r16, 0x66
  out PORTD, r16
  ret

MOSTRAR_5:
  ldi r16, 0x6D
  out PORTD, r16
  ret  

MOSTRAR_6:
  ldi r16, 0x7D
  out PORTD, r16
  ret

MOSTRAR_7:
  ldi r16, 0x07
  out PORTD, r16
  ret  

MOSTRAR_8:
  ldi r16, 0x7F
  out PORTD, r16
  ret

MOSTRAR_9:
  ldi r16, 0x6F
  out PORTD, r16
  ret  
